generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Muzakki {
  id            Int           @id @default(autoincrement())
  name          String
  gender        String?
  address       String?       @db.Text
  phone         String?
  job           String?
  password      String?
  createdAt     DateTime      @default(now())
  transactions  Transaction[]
  loginAttempts  Int           @default(0)
  lockUntil     DateTime?
  resetAttempts  Int           @default(0)
  resetLockUntil DateTime?
  resetToken     String?
  resetExpiredAt DateTime?
}

model Transaction {
  id          Int      @id @default(autoincrement())
  txId        String   @unique
  muzakkiName String
  muzakkiId   Int?
  muzakki     Muzakki? @relation(fields: [muzakkiId], references: [id])
  type        String
  amount      Float
  method      String
  status      String   // Pending, Success, Failed
  proofImage  String?  @db.LongText // For manual transfer verification
  anonymous   Boolean  @default(false)
  date        DateTime @default(now())
}

model Admin {
  id            Int       @id @default(autoincrement())
  username      String    @unique
  password      String
  name          String?
  loginAttempts Int       @default(0)
  lockUntil     DateTime?
}

model Mustahik {
  id            Int            @id @default(autoincrement())
  name          String
  category      String         // Fakir, Miskin, Amil, Muallaf, Riqab, Gharim, Fisabilillah, Ibnu Sabil
  phone         String?
  address       String?        @db.Text
  distributions Distribution[]
  createdAt     DateTime       @default(now())
}

model Distribution {
  id          Int       @id @default(autoincrement())
  mustahikId  Int?
  mustahik    Mustahik? @relation(fields: [mustahikId], references: [id])
  mustahikName String
  amount      Float
  category    String
  description String?   @db.Text
  proofImage  String?   @db.LongText // For storing base64 or path
  date        DateTime  @default(now())
}

model ZakatType {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.Text
  percentage  String?
  status      String   @default("Active") // Active, Inactive
  icon        String?  @default("HeartHandshake")
  color       String?  @default("emerald")
  createdAt   DateTime @default(now())
}

model OrganizationProfile {
  id            Int      @id @default(autoincrement())
  name          String   @default("LAZ Linsharein Amal")
  subtitle      String   @default("Lembaga Amil Zakat Nasional")
  address       String?  @db.Text
  phone         String?
  email         String?
  website       String?
  verification  String?
  vision        String?  @db.Text
  mission       String?  @db.Text // JSON string array
  logoBase64    String?  @db.LongText
  updatedAt     DateTime @updatedAt
}
