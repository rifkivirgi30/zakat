generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Muzakki {
  id              Int           @id @default(autoincrement())
  name            String
  gender          String?
  address         String?
  phone           String?
  job             String?
  password        String?
  createdAt       DateTime      @default(now())
  transactions    Transaction[]
  loginAttempts   Int           @default(0)
  lockUntil       DateTime?
  resetAttempts   Int           @default(0)
  resetLockUntil  DateTime?
  resetToken      String?
  resetExpiredAt  DateTime?
}

model Transaction {
  id          Int      @id @default(autoincrement())
  txId        String   @unique
  muzakkiName String
  muzakkiId   Int?
  muzakki     Muzakki? @relation(fields: [muzakkiId], references: [id])
  type        String
  amount      Float
  method      String
  status      String
  proofImage  String?
  anonymous   Boolean  @default(false)
  date        DateTime @default(now())
}

model Admin {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  password      String
  name          String?
  loginAttempts Int      @default(0)
  lockUntil     DateTime?
}

model Mustahik {
  id            Int            @id @default(autoincrement())
  name          String
  category      String
  phone         String?
  address       String?
  distributions Distribution[]
  createdAt     DateTime       @default(now())
}

model Distribution {
  id            Int       @id @default(autoincrement())
  mustahikId    Int?
  mustahik      Mustahik? @relation(fields: [mustahikId], references: [id])
  mustahikName  String
  amount        Float
  category      String
  description   String?
  proofImage    String?
  date          DateTime  @default(now())
}

model ZakatType {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  percentage  String?
  status      String   @default("Active")
  icon        String?  @default("HeartHandshake")
  color       String?  @default("emerald")
  createdAt   DateTime @default(now())
}

model OrganizationProfile {
  id           Int      @id @default(autoincrement())
  name         String   @default("Ma'had Fastabiqul Khoirot")
  subtitle     String   @default("Lembaga Amil Zakat Nasional")
  address      String?
  phone        String?
  email        String?
  website      String?
  verification String?
  vision       String?
  mission      String?
  logoBase64   String?
  updatedAt    DateTime @updatedAt
}